# Copy this file to .env and fill in real values. The backend imports
# backend/.env automatically for local runs; deployed environment variables
# can still override these values.

# JDBC connection (note: JDBC URL shape, not the postgresql:// shape Node uses)
DATABASE_URL=jdbc:postgresql://localhost:5432/scholarmatch
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=root

# Must be at least 32 characters (HMAC-SHA256 key requirement)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

PORT=8080
CORS_ORIGIN=*

# Local disk path where avatars/documents are stored (served at /api/uploads/**)
UPLOADS_ROOT=uploads

# Email: MAIL_MODE=log just logs verification codes/reset links to the
# console (no real email sent; fine for a local catcher like Mailpit).
# For SendGrid delivery, set MAIL_MODE=sendgrid and SENDGRID_API_KEY below.
# For generic SMTP delivery, set MAIL_MODE=smtp and fill in a real provider below.
# see backend/README.md "Real email delivery" for provider-specific notes.
MAIL_MODE=sendgrid
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_USERNAME=apikey
MAIL_PASSWORD=replace-with-sendgrid-or-smtp-password
MAIL_FROM=you@example.com

# SendGrid HTTP API. To use it, set MAIL_MODE=sendgrid and provide an API key.
# MAIL_FROM must be a verified SendGrid sender or domain.
SENDGRID_API_KEY=replace-with-sendgrid-api-key
